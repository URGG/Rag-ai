{
    "name": "kernel-workspace",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "main.cjs",
    "scripts": {
        "dev": "concurrently \"npm run fastapi\" \"vite\"",
        "fastapi": "..\\.venv\\Scripts\\python ..\\server.py",
        "build": "vite build",
        "app": "electron .",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.2.0",
        "clsx": "^2.1.1",
        "framer-motion": "^12.34.4",
        "lucide-react": "^0.575.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "tailwind-merge": "^3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.24",
        "concurrently": "^9.2.1",
        "electron": "^40.6.1",
        "electron-builder": "^24.13.3",
        "eslint": "^10.0.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.2.0",
        "vite": "^7.3.1",
        "vite-plugin-pwa": "^1.2.0"
    },
    "build": {
        "asar": true,
        "appId": "com.george.kernel",
        "productName": "Kernel Workspace",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "portable",
            "icon": "public/logo.png"
        },
        "files": [
            "ui-build/**/*",
            "main.cjs",
            "splash.html",
            "public/**/*"
        ]
    }
}
